# Verejná display konfigurácia mock frontendu. Nie je to secret.
VITE_PUBLIC_MAIL_RECEIVING_DOMAIN=doklady.dokladorpro.sk
# Verejný prepínač adaptéra, nikdy nie heslo/token. Produkcia musí používať BFF.
VITE_AUTH_MODE=bff
VITE_DATA_MODE=rest

# Server-side hodnoty. Nikdy ich nepoužívajte s prefixom VITE_.
# Nikdy ich nepoužívajte s prefixom VITE_ ani vo frontend bundle.
MAIL_RECEIVING_DOMAIN=doklady.dokladorpro.sk
APP_BASE_URL=http://localhost:5173
API_BASE_URL=http://localhost:3001
PORT=3001
DATABASE_URL=postgresql://dokladovka:dokladovka@localhost:5432/dokladovka
# Lokálny PostgreSQL-WASM fallback, ak DATABASE_URL nie je nastavené.
# Na Windows sa predvolene ukladá mimo OneDrive do %LOCALAPPDATA%\Dokladovka\pglite.
# PGLITE_DATA_DIR=C:\absolutna\cesta\k\pglite
EMAIL_PROVISIONING_MODE=catch_all
EMAIL_ALIAS_TOKEN_LENGTH=6
EMAIL_ALIAS_GRACE_DAYS=30
INBOUND_EMAIL_PROVIDER=mock
INBOUND_WEBHOOK_SECRET=change-me
# IMAP poller (npm run dev:imap) — číta schránku a posiela prílohy do inbound webhooku.
# Pre Gmail: app password z myaccount.google.com/apppasswords (nie bežné heslo).
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_POLL_INTERVAL=30
# IMAP_MAILBOX=INBOX
# Odosielanie e-mailov (registračný kód, odkaz na obnovu hesla).
# Bez SMTP_HOST sa správy iba logujú do konzoly (dev).
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, app password ako SMTP_PASSWORD.
SMTP_HOST=
SMTP_PORT=465
# Voliteľné; predvolene sa odvodí z portu (465 = implicitné TLS).
# SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Dokladovka <no-reply@doklady.dokladorpro.sk>

# Cloudflare Turnstile (captcha na prihlásení, registrácii a obnove hesla).
# Bez TURNSTILE_SECRET_KEY je captcha vypnutá. Site key je verejný a servíruje
# sa cez /api/config/public — nikdy ho nedávajte do VITE_* premenných.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

DOCUMENT_EXTRACTION_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
OPENAI_STORE_RESPONSES=false
OPENAI_TIMEOUT_MS=120000
OPENAI_MAX_RETRIES=2
EXTRACTION_MAX_FILE_BYTES=20971520
EXTRACTION_MAX_PDF_PAGES=50
AUTO_APPROVAL_ENABLED=false

OBJECT_STORAGE_MODE=s3
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_REGION=eu-central-1
OBJECT_STORAGE_BUCKET=dokladovka-private
OBJECT_STORAGE_ACCESS_KEY=change-me
OBJECT_STORAGE_SECRET_KEY=change-me
OBJECT_STORAGE_FORCE_PATH_STYLE=true

SESSION_COOKIE_SECURE=false
SESSION_TTL_HOURS=8
WORKER_POLL_INTERVAL_MS=1500
AGENT_INSTALLER_PUBLIC_BASE_URL=http://localhost:3001/downloads
AGENT_INSTALLER_DIRECTORY=agent/artifacts
# Iba dočasná výnimka; v produkcii nechajte false po nasadení dôveryhodného certifikátu.
AGENT_ALLOW_SELF_SIGNED_RELEASES=false
# Náhodný server-side token pre release workflow; nikdy nie do VITE_* ani frontendu.
AGENT_RELEASE_PUBLISH_TOKEN=
AGENT_OFFLINE_ALERT_HOURS=2
EXPORT_FAILURE_ALERT_PERCENT=20
MONITOR_INTERVAL_MS=60000

# Voliteľný prvotný admin. Seed sa bez oboch hodnôt nevykoná.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# OpenData API Financnej spravy SR (informacne zoznamy) - DIC/IC DPH v
# nasepkavaci organizacii. Kluc sa generuje na opendata.financnasprava.sk.
FS_OPENDATA_API_KEY=

# Kolko ma model "premyslat" pred extrakciou dokladu: none|minimal|low|medium|high.
# Predvolene low - doklad sa cita, neriesi sa; vyssie hodnoty len predlzuju cakanie.
# Prazdna hodnota parameter vobec neposiela (modely bez podpory rozmyslania).
OPENAI_REASONING_EFFORT=low
